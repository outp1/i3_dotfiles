# =============================================================================
# i3 Window Manager Configuration
# =============================================================================
# This file has been auto-generated by i3-config-wizard(1) and then refactored.
# It will not be overwritten, so edit it as you like.
#
# Should you change your keyboard layout some time, delete this file and
# re-run i3-config-wizard(1).
#
# Please see https://i3wm.org/docs/userguide.html for a complete reference!

# =============================================================================
# VARIABLES
# =============================================================================
set $mod Mod4
set $refresh_i3status killall -SIGUSR1 i3status
set $fast_todo_file "/home/danya/repos/obsvault/Base/FastTODO.md"

# Monitor configuration
set $MONITOR-1 HDMI-1
set $MONITOR-2 HDMI-1
set $MONITOR-3 DP-1

# Workspace definitions
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"
set $ws11 "11"
set $ws12 "12"
set $ws13 "13"
set $ws14 "14"
set $ws15 "15"

# =============================================================================
# BASIC SETTINGS
# =============================================================================
# Font for window titles and bars
font pango:monospace 8

# Alternative font (uncomment to use)
# font pango:DejaVu Sans Mono 8

# Floating modifier key
floating_modifier $mod

# Focus behavior
focus_follows_mouse no

# =============================================================================
# WINDOW APPEARANCE
# =============================================================================
# Window borders and gaps
for_window [class="^.*"] border pixel 3
gaps inner 10
gaps top 1
# gaps outer 10  # Uncomment for outer gaps

# =============================================================================
# AUTOSTART APPLICATIONS
# =============================================================================
# Desktop environment integration
exec --no-startup-id dex --autostart --environment i3

# Wallpaper
exec --no-startup-id feh --bg-fill ./docs/wallpapers/blue-4k-redmoon.jpg

# Keyboard layout
exec setxkbmap "us,ru" ",winkeys" "grp:alt_shift_toggle"

# Status bar
exec --no-startup-id polybar up1

# Compositor (uncomment to enable)
# exec --no-startup-id picom

# Drawing tool
exec --no-startup-id gromit-mpx --key F1 --undo-key F1

# Touchpad settings
exec --no-startup-id syndaemon -i 1 -t -K -R -d

# Power management
exec --no-startup-id tlp start

# Screen locker
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork

# Network manager
exec --no-startup-id nm-applet

# Display configuration (uncomment if needed)
# exec --no-startup-id xrandr --output HDMI-1 --above eDP-1

# Autoscreen locker (uncomment to enable)
# exec --no-startup-id xautolock -detectsleep -time 3 -locker lock

# =============================================================================
# KEYBINDINGS
# =============================================================================

# Application Launchers
bindsym $mod+Return exec ghostty
bindsym $mod+space exec --no-startup-id ~/.config/rofi/launchers/type-3/launcher.sh
bindsym $mod+n exec --no-startup-id ~/.config/rofi/powermenu/type-2/powermenu.sh

# Window Management
bindsym $mod+Shift+q kill
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+a focus parent

# Layout Management
bindsym $mod+g split h
bindsym $mod+v split v
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# Focus Movement (Vim-style)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Focus Movement (Arrow keys)
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Window Movement (Vim-style)
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Window Movement (Arrow keys)
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Audio Control
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10% && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10% && $refresh_i3status
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status

# Screenshots
bindsym $mod+q exec flameshot gui
bindcode 107 exec flameshotscreenfix

# Custom Shortcuts
bindsym $mod+Shift+T exec --no-startup-id todo -P $fast_todo_file -h "Fast" "$(xclip -o -selection clipboard)"
bindsym $mod+Shift+s exec --no-startup-id /home/danya/repos/sh-scripts/dictate-loop.sh

# System Control
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

# =============================================================================
# WORKSPACE CONFIGURATION
# =============================================================================

# Workspace to monitor assignments
workspace $ws1 output $MONITOR-1
workspace $ws2 output $MONITOR-1
workspace $ws3 output $MONITOR-1
workspace $ws4 output $MONITOR-1
workspace $ws5 output $MONITOR-1
workspace $ws6 output $MONITOR-1
workspace $ws7 output $MONITOR-3
workspace $ws8 output $MONITOR-3
workspace $ws9 output $MONITOR-3
workspace $ws10 output $MONITOR-3
workspace $ws11 output $MONITOR-2
workspace $ws12 output $MONITOR-2
workspace $ws13 output $MONITOR-2
workspace $ws14 output $MONITOR-2
workspace $ws15 output $MONITOR-2

# Switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10
bindsym $mod+y workspace number $ws11
bindsym $mod+u workspace number $ws12
bindsym $mod+i workspace number $ws13
bindsym $mod+o workspace number $ws14
bindsym $mod+p workspace number $ws15

# Move container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10
bindsym $mod+Shift+y move container to workspace number $ws11
bindsym $mod+Shift+u move container to workspace number $ws12
bindsym $mod+Shift+i move container to workspace number $ws13
bindsym $mod+Shift+o move container to workspace number $ws14
bindsym $mod+Shift+p move container to workspace number $ws15

# =============================================================================
# SPECIAL MODES
# =============================================================================

# Resize mode
mode "resize" {
    # Vim-style resize bindings
    bindsym h resize shrink width 5 px or 5 ppt
    bindsym j resize grow height 5 px or 5 ppt
    bindsym k resize shrink height 5 px or 5 ppt
    bindsym l resize grow width 5 px or 5 ppt

    # Arrow key resize bindings
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt

    # Exit resize mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}

# Enter resize mode
bindsym $mod+r mode "resize"

